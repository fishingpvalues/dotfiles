# bat. The file really is called `config`, with no extension.
# bat ships 28 themes and GitHub Dark is not one of them - its built-in
# "GitHub" is the LIGHT theme. bat also exits 0 on an unknown theme name and
# silently falls back to the default, so the previous "Catppuccin Mocha" here
# was doing nothing at all and looked fine. "Visual Studio Dark+" is the
# closest valid match to GitHub's dark palette.
--theme="Visual Studio Dark+"
--style="numbers,changes,header-filename"
--wrap=auto
--italic-text=always
--paging=auto

# Files whose name gives bat no clue what they are.
--map-syntax "*.conf:INI"
--map-syntax ".env*:Bash"
--map-syntax "*.jenkinsfile:Groovy"
--map-syntax "**/Dockerfile*:Dockerfile"
--map-syntax "**/.gitconfig:INI"
--map-syntax "*.kdl:JavaScript"

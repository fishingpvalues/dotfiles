#!/bin/bash
# Install the fish plugins listed in fish_plugins.
#
# fisher was already on this machine but nothing recorded WHICH plugins were
# installed, so the set was unreproducible - a fresh machine got fisher and no
# plugins, and nobody could tell what was missing. The list is now a tracked
# file and this script reconciles to it.
#
# plugins: {{ include "dot_config/fish/fish_plugins" | sha256sum }}
set -euo pipefail

command -v fish >/dev/null || exit 0

# fzf.fish rebinds ctrl-r and it WINS over atuin, which is the opposite of what
# you want. conf.d is sourced in lexical order and fzf.fish sorts after
# 10-init.fish, so the plugin's binding lands last. conf.d/zz-keybinds.fish
# sorts after both and puts atuin back. Check with `bind ctrl-r` - it must say
# _atuin_search, not _fzf_search_history.
fish -c '
    if not functions -q fisher
        curl -sL https://raw.githubusercontent.com/jorgebucaran/fisher/main/functions/fisher.fish |
            source
        and fisher install jorgebucaran/fisher
    end
    fisher update
' 2>&1 | tail -5

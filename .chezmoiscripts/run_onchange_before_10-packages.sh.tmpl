#!/bin/bash
# Install the toolchain these dotfiles configure.
#
# run_onchange_: chezmoi re-runs this only when the file's contents change, and
# the package list is IN the file, so adding a tool below is what triggers a
# reinstall. The hash line makes that explicit.
#
# packages hash: {{ include ".chezmoiscripts/run_onchange_before_10-packages.sh.tmpl" | sha256sum }}
set -euo pipefail

command -v pacman >/dev/null || { echo "not an Arch system, skipping"; exit 0; }

# Everything here is in the official CachyOS/Arch repos - checked, not assumed.
# carapace is the one that is not, and it is deliberately omitted rather than
# pulling in an AUR helper for a single completion engine.
packages=(
    # shell + prompt
    fish starship atuin zoxide fzf direnv
    # the replacements
    eza bat ripgrep fd dust duf procs sd bottom btop
    # git
    git-delta lazygit gitui difftastic
    # files, search, navigation
    yazi broot television serpl dysk fclones ouch
    # network
    xh dog gping trippy
    # dev
    neovim helix tmux jq yq glow hyperfine tokei mise navi tealdeer
    # containers
    lazydocker dive

    # Laptop hardware, because Hyprland ships no settings panel. impala and
    # bluetui are Omarchy's picks for exactly this reason; wiremix is the
    # pipewire mixer. Without these, changing wifi or an audio sink means
    # nmcli/wpctl incantations from memory.
    impala bluetui wiremix

    # sops: potatostack's .env is SOPS+age encrypted and this laptop
    # administers it. age was already here, sops was not, so `make sops-decrypt`
    # could not run from this machine at all.
    sops

    # git-absorb: takes staged changes and amends each one into the commit that
    # introduced the line, instead of a pile of "fix review comment" commits.
    # ast-grep: structural search and replace over the syntax tree. Complements
    # ripgrep rather than duplicating it - rg cannot match "this call, but only
    # when the second argument is a literal".
    git-absorb ast-grep
    # fonts + clipboard, needed by the above on wayland
    ttf-jetbrains-mono-nerd wl-clipboard
)

missing=()
for p in "${packages[@]}"; do
    pacman -Qq "$p" &>/dev/null || missing+=("$p")
done

if [ ${#missing[@]} -eq 0 ]; then
    echo "all ${#packages[@]} packages already installed"
    exit 0
fi

echo "installing ${#missing[@]} packages: ${missing[*]}"

# Fail SOFT if we cannot escalate. `chezmoi apply` runs this before it writes a
# single file, so a hard exit here means no dotfiles at all - on a machine where
# the only thing wrong is that this user cannot sudo right now. Print what to
# run and carry on; the configs are still worth having without every binary.
if sudo -n true 2>/dev/null || sudo -v 2>/dev/null; then
    sudo pacman -S --needed --noconfirm "${missing[@]}"
elif [ "$(id -u)" -eq 0 ]; then
    pacman -S --needed --noconfirm "${missing[@]}"
else
    echo "WARNING: cannot escalate, skipping package install." >&2
    echo "Run this yourself, then re-run chezmoi apply:" >&2
    echo "    sudo pacman -S --needed ${missing[*]}" >&2
    exit 0
fi

# tldr pages are useless until the cache is built, and the first `tldr foo`
# after a fresh install otherwise just errors.
command -v tldr >/dev/null && tldr --update >/dev/null 2>&1 || true

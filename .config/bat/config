# Bat configuration (SOTA 2025)
# https://github.com/sharkdp/bat
# Location: ~/.config/bat/config
# Note: This file is named 'config' not 'bat.conf' or 'config.toml'

# Theme (GitHub Dark to match Neovim setup)
--theme="GitHub"

# Show line numbers and git modifications
--style="numbers,changes,header"

# Wrap text instead of horizontal scrolling
--wrap=auto

# Use italic text (requires terminal support)
--italic-text=always

# Show non-printable characters
--show-all

# Use pager only when output is longer than screen
--paging=auto

# Add file extensions for syntax highlighting
--map-syntax "*.conf:INI"
--map-syntax ".ignore:Git Ignore"
--map-syntax "*.ino:C++"

# Tabs: Set to 4 spaces
--tabs=4

# SOTA Note: Bat is a cat clone with syntax highlighting and Git integration
# Integrates well with other modern CLI tools like ripgrep and fd

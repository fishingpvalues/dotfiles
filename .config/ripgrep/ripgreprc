# ripgrep configuration (SOTA 2025)
# https://github.com/BurntSushi/ripgrep
# Location: ~/.config/ripgrep/ripgreprc
# Set environment variable: export RIPGREP_CONFIG_PATH=~/.config/ripgrep/ripgreprc

# Limit line length to avoid performance issues
--max-columns=150
--max-columns-preview

# Smart case: case-insensitive unless uppercase letters are used
--smart-case

# Search hidden files and directories
--hidden

# Follow symbolic links
--follow

# Sort results by file path
--sort=path

# Use colors (auto-detect terminal support)
--colors=line:none
--colors=line:style:bold
--colors=path:fg:green
--colors=path:style:bold
--colors=match:fg:yellow
--colors=match:style:bold

# Exclude version control directories
--glob=!.git/*
--glob=!.svn/*
--glob=!.hg/*

# Exclude dependency directories
--glob=!node_modules/*
--glob=!vendor/*
--glob=!bower_components/*

# Exclude build outputs
--glob=!dist/*
--glob=!build/*
--glob=!target/*
--glob=!out/*
--glob=!*.min.js
--glob=!*.min.css

# Exclude cache directories
--glob=!.cache/*
--glob=!__pycache__/*
--glob=!*.pyc
--glob=!.pytest_cache/*
--glob=!.mypy_cache/*
--glob=!.ruff_cache/*

# Exclude IDE files
--glob=!.vscode/*
--glob=!.idea/*
--glob=!*.swp
--glob=!*.swo
--glob=!*~

# Exclude OS files
--glob=!.DS_Store
--glob=!Thumbs.db

# Exclude logs
--glob=!*.log
--glob=!logs/*

# Add custom file types
--type-add=web:*.{html,css,scss,sass,less,js,jsx,ts,tsx,vue}
--type-add=config:*.{json,yaml,yml,toml,ini,conf,config}
--type-add=doc:*.{md,rst,txt,adoc}

# SOTA Note: ripgrep is a fast grep alternative
# Use with bat for better output: rg --json <pattern> | bat
# Override config with --no-config flag

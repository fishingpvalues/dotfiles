# Zoxide environment configuration (SOTA 2025)
# https://github.com/ajeetdsouza/zoxide
# Location: ~/.config/zoxide/zoxide.env
# Source this file in your shell config (.bashrc, .zshrc, etc.)

# Print the matched directory before navigating
export _ZOXIDE_ECHO=1

# Exclude directories from the database (semicolon-separated on Windows, colon on Unix)
# Default excludes $HOME
export _ZOXIDE_EXCLUDE_DIRS="$HOME:$HOME/tmp:$HOME/temp"

# Maximum number of entries in the database (default: 10000)
export _ZOXIDE_MAXAGE=10000

# Resolve symlinks before adding to database
export _ZOXIDE_RESOLVE_SYMLINKS=0

# Custom fzf options for interactive selection (zi command)
export _ZOXIDE_FZF_OPTS="--height 40% --reverse --border --preview 'ls -la {2..}' --preview-window=right:50%"

# SOTA Note: Zoxide is a smarter cd command
# Initialize in your shell config with:
#   For bash: eval "$(zoxide init bash)"
#   For zsh: eval "$(zoxide init zsh)"
#   For fish: zoxide init fish | source
#
# Usage:
#   z <directory>  - Jump to a directory
#   zi             - Interactive selection with fzf
#   z -            - Go to previous directory
#   z foo bar      - Jump to directory with "foo" and "bar" in path
#
# Integration with other tools:
#   - Works with yazi (file manager): yazi uses 'z' command
#   - Works with fzf: zi command uses fzf for interactive selection

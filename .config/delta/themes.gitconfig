# Git Delta themes configuration (SOTA 2025)
# Include this in your main .gitconfig:
# [include]
#     path = ~/.config/delta/themes.gitconfig

[delta "github-dark"]
    # Syntax theme matching GitHub Dark
    syntax-theme = GitHub

    # Line numbers
    line-numbers = true
    line-numbers-left-format = "{nm:>4}┊"
    line-numbers-right-format = "{np:>4}│"
    line-numbers-left-style = brightblack
    line-numbers-right-style = brightblack
    line-numbers-minus-style = brightred
    line-numbers-plus-style = brightgreen

    # File paths
    file-style = bold yellow
    file-decoration-style = yellow ul

    # Hunk headers
    hunk-header-style = syntax bold
    hunk-header-decoration-style = blue box

    # Diff colors
    minus-style = syntax "#3f1f1f"
    minus-emph-style = syntax "#862626"
    plus-style = syntax "#1f3f1f"
    plus-emph-style = syntax "#26862"

    # Side-by-side
    side-by-side = false

    # Navigation (use n/N for next/prev file)
    navigate = true

    # Blame
    blame-format = "{author:<18} {commit:<8} {timestamp:<15}"
    blame-palette = "#1f2937 #374151 #4b5563"

# SOTA Note: Delta provides syntax highlighting for git diff output
# Use with: git config --global include.path ~/.config/delta/themes.gitconfig
# Then in .gitconfig, add: [delta] features = github-dark

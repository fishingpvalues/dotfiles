// Zellij configuration (SOTA 2025)
// https://zellij.dev
// Location: ~/.config/zellij/config.kdl

// Theme colors (GitHub Dark)
theme "github-dark" {
    fg "#c9d1d9"
    bg "#0d1117"
    black "#484f58"
    red "#ff7b72"
    green "#7ee787"
    yellow "#ffa657"
    blue "#79c0ff"
    magenta "#d2a8ff"
    cyan "#a5d6ff"
    white "#b1bac4"
    orange "#ffa657"
}

themes {
    github-dark {
        fg 201 209 217
        bg 13 17 23
        black 72 79 88
        red 255 123 114
        green 126 231 135
        yellow 255 166 87
        blue 121 192 255
        magenta 210 168 255
        cyan 165 214 255
        white 177 186 196
        orange 255 166 87
    }
}

// Use the GitHub Dark theme
theme "github-dark"

// Simplified mode with essential features
simplified_ui true

// Default shell
// default_shell "bash"

// Default layout
// default_layout "compact"

// Vim-friendly keybindings using Alt instead of Ctrl to avoid collisions
keybinds clear-defaults=true {
    // Normal mode - use Alt-based bindings to avoid vim conflicts
    normal {
        // Pane navigation (vim-style with Alt)
        bind "Alt h" { MoveFocus "Left"; }
        bind "Alt j" { MoveFocus "Down"; }
        bind "Alt k" { MoveFocus "Up"; }
        bind "Alt l" { MoveFocus "Right"; }

        // Pane management
        bind "Alt n" { NewPane; }
        bind "Alt v" { NewPane "Right"; }
        bind "Alt s" { NewPane "Down"; }
        bind "Alt x" { CloseFocus; }
        bind "Alt f" { ToggleFocusFullscreen; }

        // Tab management
        bind "Alt t" { NewTab; }
        bind "Alt w" { CloseTab; }
        bind "Alt [" { GoToPreviousTab; }
        bind "Alt ]" { GoToNextTab; }

        // Resize mode
        bind "Alt r" { SwitchToMode "Resize"; }

        // Pane mode
        bind "Alt p" { SwitchToMode "Pane"; }

        // Tab mode
        bind "Alt T" { SwitchToMode "Tab"; }

        // Scroll mode
        bind "Alt e" { SwitchToMode "Scroll"; }

        // Session mode
        bind "Alt o" { SwitchToMode "Session"; }

        // Quit
        bind "Alt q" { Quit; }

        // Detach
        bind "Alt d" { Detach; }
    }

    // Resize mode (vim-style)
    resize {
        bind "Esc" { SwitchToMode "Normal"; }
        bind "h" { Resize "Increase Left"; }
        bind "j" { Resize "Increase Down"; }
        bind "k" { Resize "Increase Up"; }
        bind "l" { Resize "Increase Right"; }
        bind "H" { Resize "Decrease Left"; }
        bind "J" { Resize "Decrease Down"; }
        bind "K" { Resize "Decrease Up"; }
        bind "L" { Resize "Decrease Right"; }
    }

    // Scroll mode (vim-style)
    scroll {
        bind "Esc" { SwitchToMode "Normal"; }
        bind "q" { SwitchToMode "Normal"; }
        bind "j" { ScrollDown; }
        bind "k" { ScrollUp; }
        bind "d" { HalfPageScrollDown; }
        bind "u" { HalfPageScrollUp; }
        bind "f" { PageScrollDown; }
        bind "b" { PageScrollUp; }
        bind "g" { ScrollToTop; }
        bind "G" { ScrollToBottom; }
        bind "/" { Search "down"; }
        bind "?" { Search "up"; }
        bind "n" { Search "down"; }
        bind "N" { Search "up"; }
    }

    // Pane mode
    pane {
        bind "Esc" { SwitchToMode "Normal"; }
        bind "h" { MoveFocus "Left"; }
        bind "j" { MoveFocus "Down"; }
        bind "k" { MoveFocus "Up"; }
        bind "l" { MoveFocus "Right"; }
        bind "v" { NewPane "Right"; SwitchToMode "Normal"; }
        bind "s" { NewPane "Down"; SwitchToMode "Normal"; }
        bind "x" { CloseFocus; SwitchToMode "Normal"; }
        bind "f" { ToggleFocusFullscreen; SwitchToMode "Normal"; }
        bind "z" { TogglePaneFrames; SwitchToMode "Normal"; }
        bind "r" { SwitchToMode "Resize"; }
    }

    // Tab mode
    tab {
        bind "Esc" { SwitchToMode "Normal"; }
        bind "h" { GoToPreviousTab; }
        bind "l" { GoToNextTab; }
        bind "n" { NewTab; SwitchToMode "Normal"; }
        bind "x" { CloseTab; SwitchToMode "Normal"; }
        bind "r" { SwitchToMode "RenameTab"; }
    }

    // Rename tab mode
    renametab {
        bind "Esc" { SwitchToMode "Normal"; }
    }

    // Session mode
    session {
        bind "Esc" { SwitchToMode "Normal"; }
        bind "d" { Detach; }
    }
}

// Mouse support
mouse_mode true

// Copy command (OS-specific)
copy_command "pbcopy"  // macOS
// copy_command "xclip -selection clipboard"  // Linux X11
// copy_command "wl-copy"  // Linux Wayland

// Clipboard sync
copy_on_select true

// Scroll buffer size
scroll_buffer_size 10000

// Mirror session
mirror_session false

// SOTA Note: Zellij is a modern tmux alternative with vim-style keybindings
// This config uses Alt-based bindings to avoid conflicts with Neovim
// Use Alt+h/j/k/l for navigation, Alt+v/s for splits, Alt+q to quit
// Press Alt+p for pane mode, Alt+e for scroll mode (uses vim keys)

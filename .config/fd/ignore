# fd global ignore file (SOTA 2025)
# https://github.com/sharkdp/fd
# Location: ~/.config/fd/ignore
# This file works like .gitignore but is specific to fd

# Version control
.git/
.svn/
.hg/

# Dependencies
node_modules/
vendor/
bower_components/

# Build outputs
dist/
build/
target/
out/
*.o
*.so
*.dylib
*.dll
*.exe

# Cache directories
.cache/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/

# IDE/Editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Temporary files
tmp/
temp/
*.tmp

